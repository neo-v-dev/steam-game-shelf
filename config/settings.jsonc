// サイトの公開設定。行頭が // の行はコメントとして無視されます。
// GitHub 上で直接このファイルを編集して保存(コミット)すると、サイトが自動で再生成されます。
{
  // サイトを公開するか。初期設定と非表示設定が終わったら true にしてください。
  "published": false,

  // サイトのタイトルと説明文
  "site_title": "My Game Shelf",
  "site_description": "",

  // 初期表示言語: "ja" または "en"(閲覧者はサイト上で切り替え可能)
  "default_lang": "ja",

  // プレイ時間を表示するか(サイト全体のスイッチ。ゲームごとの設定は管理ページから)
  "show_playtime": true,

  // 配信チャンネルの URL(設定するとページ上部にリンクが表示されます)
  "channel_url": "",

  // 最終プレイ日を表示するか
  "show_last_played": true,

  // 日本語のゲーム名を取得するか。日本語表示のとき、邦題があれば邦題で表示されます。
  // ストア API のレート制限のため、所持数が多い場合は数回の更新に分けて少しずつ取得されます。
  "fetch_japanese_names": true,

  // 新しく取得されたゲームをデフォルトで表示するか。
  // false にすると、新規ゲームは data/catalog.json で visible を true にするまで表示されません。
  "default_visibility": true
}
